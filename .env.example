# DO.Impact Core (open-source edition)
# Copy this file to .env and fill in your local Supabase credentials.
# With the Supabase CLI local stack (`supabase start`), the defaults below work
# out of the box — the anon key is printed by `supabase status`.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-local-anon-key

# Server-side functions (same values are fine for local development)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-local-anon-key
# Optional: service role key for full access (printed by `supabase status`)
# SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
